---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md border-b border-surface-light">
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="font-display font-bold text-accent text-lg tracking-tight">
      santy<span class="text-text">dev</span>
    </a>
    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-text-muted hover:text-accent text-sm transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/Santy401"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-muted hover:text-accent text-sm transition-colors duration-200"
      >
        GitHub
      </a>
    </div>
  </div>
</nav>
